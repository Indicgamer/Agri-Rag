# ============================================
# Agri-RAG Environment Configuration
# ============================================
# IMPORTANT: This file contains sensitive data!
# Never commit to version control
# ============================================

# ========== LLM PROVIDER ==========
# Choose ONE: "ollama" OR "openai"

# Option A: LOCAL OLLAMA (RECOMMENDED FOR TESTING)
# - Free, no API key needed
# - Requires Ollama installed + running
# - Slower but unlimited usage
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Option B: OPENAI API (Production)
# - Requires valid API key
# - Faster responses
# - Costs money per API call
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here_replace_this
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option C: GROQ API (Free / External)
# - Uses Groq hosted model
# - Best for low-RAM setups
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_key_here_replace_this
# GROQ_MODEL=llama-3.1-8b-instant

# ========== NLI PRUNER ==========
# Uses DeBERTa for fact validation
NLI_PROVIDER=transformers
NLI_MODEL=cross-encoder/nli-deberta-v3-base
NLI_DEVICE=cpu

# ========== NEO4J GRAPH DATABASE ==========
# Store knowledge graph triplets
# Requires Neo4j running: docker run -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/password neo4j:latest
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
AGRI_RAG_NEO4J_DATABASE=neo4j

# ========== CHROMADB VECTOR STORE ==========
# Vector embeddings for semantic search
CHROMADB_PERSISTENCE_DIR=data/chroma_db
CHROMADB_COLLECTION_NAME=agriculture_corpus
CHROMADB_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ========== FALLBACK STRATEGIES ==========
# Enable graceful degradation when services fail
ALLOW_RULE_FALLBACK=false
ALLOW_RESPONSE_FALLBACK=true
GROQ_MAX_RETRIES=2
GROQ_MAX_RATE_LIMIT_WAIT_SECONDS=30

# ========== PROCESSING PARAMETERS ==========
# For PDF/document processing
CHUNK_SIZE=512
CHUNK_OVERLAP=50
BATCH_SIZE=10
MAX_PAGES_FOR_TESTING=5

# ========== LOG LEVEL ==========
LOG_LEVEL=INFO
